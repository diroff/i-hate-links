  m_TableData:
  - m_Id: 173824778240
    m_Localized: Hi!
    m_Metadata:
      m_Items: []
  - m_Id: 310181601280
    m_Localized: Apple! I love it!
    m_Metadata:
      m_Items: []
  - m_Id: 408991014912
    m_Localized: It's so tasty!
    m_Metadata:
      m_Items: []
  - m_Id: 644262109184
    m_Localized: "Oh, you shouldn\u2019t have come here..."
    m_Metadata:
      m_Items: []
  - m_Id: 2411905392640
    m_Localized: Who are you anyway?
    m_Metadata:
      m_Items: []
  - m_Id: 2562313134080
    m_Localized: I won't tell :)
    m_Metadata:
      m_Items: []
  - m_Id: 5798734569472
    m_Localized: I need a key.
    m_Metadata:
      m_Items: []
  - m_Id: 5902388404224
    m_Localized: The chest disappeared because of your greed.
    m_Metadata:
      m_Items: []
  - m_Id: 587026508521472
    m_Localized: Let there be light!
    m_Metadata:
      m_Items: []
  - m_Id: 587133995950080
    m_Localized: It seems this is the key to the door.
    m_Metadata:
      m_Items: []
  - m_Id: 597427400974336
    m_Localized: Locked, need the key.
    m_Metadata:
      m_Items: []
